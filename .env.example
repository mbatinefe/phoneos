# ---- dashboard / API ---------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Required before WEB_HOST is changed away from loopback.
# PHONEOS_AUTH_PLUGIN=@your-org/phoneos-auth

# ---- database (scheduler) ----------------------------------------------------
DATABASE_URL=postgresql://phoneos:CHANGE_ME@127.0.0.1:5432/phoneos
POSTGRES_DB=phoneos
POSTGRES_USER=phoneos
POSTGRES_PASSWORD=CHANGE_ME
SCHEDULER_DATA_DIR=.scheduler-data

# ---- devices -----------------------------------------------------------------
# Registered devices (and their unlock passcodes) live in devices.json — git-ignored, written 0600.
DEVICES_CONFIG_PATH=devices.json
# Default local ports for a device without explicit ones in devices.json.
WDA_LOCAL_PORT=8100
MJPEG_LOCAL_PORT=9100

# ---- WebDriverAgent build (real devices only; simulators build unsigned) -----
# Apple Development Team ID (Xcode → Settings → Accounts).
XCODE_ORG_ID=replace-me
XCODE_SIGNING_ID=Apple Development
# A bundle id you control.
WDA_BUNDLE_ID=com.example.WebDriverAgentRunner
# The deployment target when a phone's own iOS version is not known (ignored for simulators).
# IOS_PLATFORM_VERSION=17.0
# Optional: pin Xcode / WDA locations instead of xcode-select / the release wda:prepare downloads into .wda/.
# XCODE_DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# WDA_ROOT=.wda/webdriveragent-8.9.1
# WDA_DERIVED_DATA=.wda/derived-data

# ---- agent interface ---------------------------------------------------------
# Comma-separated extra ESM plugin packages (local app packs in apps/ load automatically).
PHONEOS_PLUGINS=
# PHONEOS_APPS_DIR=apps
# Override every device's gesture profile for the MCP server: precise | natural | relaxed
# PHONEOS_HUMAN_PROFILE=natural

# ---- advanced: the defaults suit nearly everyone ---------------------------------
# Where sessions, reports, pulled files and recordings go.
# PHONEOS_STATE_DIR=.phoneos
# The MCP server starts the WebDriverAgent service by itself unless this is false.
# PHONEOS_AUTOSTART_WDA=true
# Origins allowed to call the dashboard besides itself (comma-separated), e.g. behind a proxy.
# PUBLIC_ORIGIN=https://phones.example.com
# PHONEOS_TRUSTED_ORIGINS=
# The WebDriverAgent service's socket; the project to build; the agent's ports on the phone.
# WDA_SERVICE_SOCKET=.wda/wda-service.sock
# WDA_PROJECT_PATH=.wda/webdriveragent-8.9.1/WebDriverAgent.xcodeproj
# WDA_REMOTE_PORT=8100
# MJPEG_REMOTE_PORT=9100
# Scheduler: connections, how long a missed run may still start, history and asset clean-up.
# DATABASE_POOL_SIZE=10
# SCHEDULER_RUN_WINDOW_MINUTES=30
# SCHEDULER_MIN_TASK_GAP_MINUTES=10
# SCHEDULER_HISTORY_DAYS=30
# SCHEDULER_ORPHAN_ASSET_HOURS=24
# The port docker-compose publishes Postgres on.
# POSTGRES_PORT=5432
